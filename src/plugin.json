{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "AI Assistant",
  "id": "acme-aiassistant-app",
  "backend": true,
  "executable": "gpx_ai_assistant",
  "info": {
    "keywords": ["app"],
    "description": "Pure on-premise Grafana AI assistant powered by Grafana Live and a self-hosted LLM.",
    "author": {
      "name": "Acme"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "AI Assistant",
      "path": "/a/%PLUGIN_ID%/assistant",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
